# npm auto-installs each workspace package's peerDependencies into a nested
# node_modules, writing versionless `{"peer": true}` placeholder nodes that
# `npm ci` then rejects with `Invalid Version:`. It also yields a second copy of
# `effect` on some machines, which surfaces as mismatched types (two distinct
# `NodeInspectSymbol`s). The root `dependencies` plus `overrides` already pin one
# exact version of every peer, so peer resolution has nothing left to decide.
legacy-peer-deps=true
