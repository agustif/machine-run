{
  "name": "machine-run",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b && oxlint",
    "clean": "rm -rf .tsbuild packages/*/lib examples/*/lib packages/*/tsconfig.tsbuildinfo examples/*/tsconfig.tsbuildinfo tsconfig.tests.tsbuildinfo",
    "format": "oxfmt packages examples",
    "format:check": "oxfmt --check packages examples",
    "lint": "oxlint",
    "patches:check": "bash scripts/apply-patches.sh",
    "postinstall": "bash scripts/apply-patches.sh",
    "test": "tsc -b && vitest run"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.108",
    "@effect/vitest": "4.0.0-rc.108",
    "@types/node": "^24.0.0",
    "alchemy": "2.0.0-beta.72",
    "effect": "4.0.0-rc.108",
    "ioredis": "^5.7.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.78.0",
    "oxlint-plugin-effect": "^0.8.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "effect": "4.0.0-rc.108",
    "alchemy": "2.0.0-beta.72",
    "@effect/platform-node": "4.0.0-rc.108",
    "@effect/vitest": "4.0.0-rc.108"
  }
}
