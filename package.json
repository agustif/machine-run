    "oxlint-plugin-effect": "^0.8.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "effect": "4.0.0-beta.107",
    "alchemy": "2.0.0-beta.72",
    "@effect/platform-node": "4.0.0-beta.107",
    "@effect/vitest": "4.0.0-beta.107"
